# BountyMine store sync
# Edit the two options below, then `/skript reload bountymine-sync`.
# sync-token must match SYNC_TOKEN on the Heroku app.
#
# The web app queues delivery commands in Postgres and this script pulls them:
#   every 10s  GET  /api/mc/pending   -> run each "id|command" line as console
#              POST /api/mc/ack       -> confirm the ids that ran
#   every 60s  GET  /api/mc/goal      -> cache money-goal values
#              GET  /api/mc/leaderboard -> cache the top-5 donators
#
# NOTE: `execute console command` is the classic Skript form for running a
# console command. If your Skript version rejects it, use
# `execute command "%{_cmd}%" by console` instead.
options:
	base-url: https://mc-store-b216cbdae28a.herokuapp.com
	sync-token: replace-with-sync-token

import:
	java.net.URL
	java.net.HttpURLConnection
	java.io.BufferedReader
	java.io.InputStreamReader
	java.io.OutputStreamWriter

# Returns the response body with lines joined by ";;" (empty on non-200).
function bountymine_http_get(path: text) :: text:
	set {_urlObj} to new URL("%{@base-url}%%{_path}%")
	set {_conn} to {_urlObj}.openConnection()
	{_conn}.setRequestMethod("GET")
	{_conn}.setConnectTimeout(5000)
	{_conn}.setReadTimeout(5000)
	{_conn}.setRequestProperty("Authorization", "Bearer %{@sync-token}%")
	set {_code} to {_conn}.getResponseCode()
	if {_code} is not 200:
		broadcast "&c[BountyMine Sync] GET %{_path}% failed with HTTP %{_code}%." to console
		return ""
	set {_stream} to {_conn}.getInputStream()
	set {_isr} to new InputStreamReader({_stream})
	set {_reader} to new BufferedReader({_isr})
	set {_result} to ""
	set {_line} to {_reader}.readLine()
	while {_line} is set:
		if {_result} is "":
			set {_result} to {_line}
		else:
			set {_result} to "%{_result}%;;%{_line}%"
		set {_line} to {_reader}.readLine()
	{_reader}.close()
	return {_result}

# POSTs a plain-text body ("1,2,3") to /api/mc/ack. Returns the body or "".
function bountymine_http_post(path: text, body: text) :: text:
	set {_urlObj} to new URL("%{@base-url}%%{_path}%")
	set {_conn} to {_urlObj}.openConnection()
	{_conn}.setRequestMethod("POST")
	{_conn}.setConnectTimeout(5000)
	{_conn}.setReadTimeout(5000)
	{_conn}.setRequestProperty("Authorization", "Bearer %{@sync-token}%")
	{_conn}.setRequestProperty("Content-Type", "text/plain")
	{_conn}.setDoOutput(true)
	set {_os} to {_conn}.getOutputStream()
	set {_writer} to new OutputStreamWriter({_os})
	{_writer}.write("%{_body}%")
	{_writer}.flush()
	{_writer}.close()
	set {_code} to {_conn}.getResponseCode()
	if {_code} is not 200:
		broadcast "&c[BountyMine Sync] POST %{_path}% failed with HTTP %{_code}%." to console
		return ""
	set {_stream} to {_conn}.getInputStream()
	set {_isr} to new InputStreamReader({_stream})
	set {_reader} to new BufferedReader({_isr})
	set {_result} to {_reader}.readLine()
	{_reader}.close()
	return {_result}

every 10 seconds:
	set {_raw} to bountymine_http_get("/api/mc/pending")
	if {_raw} is "":
		stop

	set {_ids} to ""
	loop {_raw} split at ";;":
		set {_line} to loop-value
		if {_line} contains "|":
			set {_row::*} to {_line} split at "|"
			set {_id} to {_row::1}
			set {_cmd} to {_row::2}
			execute console command "%{_cmd}%"
			if {_ids} is "":
				set {_ids} to "%{_id}%"
			else:
				set {_ids} to "%{_ids}%,%{_id}%"

	if {_ids} is not "":
		set {_ack} to bountymine_http_post("/api/mc/ack", {_ids})

every 60 seconds:
	set {_goalRaw} to bountymine_http_get("/api/mc/goal")
	if {_goalRaw} is "":
		broadcast "&c[BountyMine Sync] Failed to fetch goal data." to console
	else:
		# current cents | target cents | reached (1/0)
		set {_goal::*} to {_goalRaw} split at "|"
		set {bountymine::goal::current} to {_goal::1}
		set {bountymine::goal::target} to {_goal::2}
		set {bountymine::goal::reached} to {_goal::3}

	set {_lbRaw} to bountymine_http_get("/api/mc/leaderboard")
	if {_lbRaw} is "":
		broadcast "&c[BountyMine Sync] Failed to fetch leaderboard data." to console
	else:
		delete {bountymine::leaderboard::*}
		set {_i} to 0
		loop {_lbRaw} split at ";;":
			if loop-value contains "|":
				add 1 to {_i}
				set {_row::*} to loop-value split at "|"
				set {bountymine::leaderboard::%{_i}%::name} to {_row::1}
				set {bountymine::leaderboard::%{_i}%::total} to {_row::2}
