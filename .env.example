# Heroku sets PORT automatically. Locally 3000 is fine.
PORT=3000
NODE_ENV=development

# Public origin of the store, used for Stripe success/cancel URLs.
BASE_URL=http://localhost:3000

# Heroku Postgres sets DATABASE_URL automatically.
# Locally, point this at your own Postgres database.
DATABASE_URL=postgres://postgres:password@127.0.0.1:5432/mc_store
# Set to true when your Postgres requires SSL (production/Heroku does).
DATABASE_SSL=false

# Stripe (test mode only until you are ready to go live).
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Shared secret for /api/mc/* pulled by the Minecraft server.
SYNC_TOKEN=replace-with-a-long-random-token

# Discord widget guild id (leave empty to show the fallback member count).
DISCORD_GUILD_ID=

# Admin panel credentials.
ADMIN_LOGIN=admin
ADMIN_PASSWORD=change-me
